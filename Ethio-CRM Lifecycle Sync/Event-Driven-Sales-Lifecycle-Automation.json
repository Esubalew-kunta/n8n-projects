    {
      "parameters": {
        "jsCode": "// Returns a copy of the object by removing:\n// - null, undefined\n// - empty strings \"\"\n// - empty objects/arrays after cleaning\nfunction clean(value) {\n  if (Array.isArray(value)) {\n    const arr = value.map(clean)\n      .filter(v => !(v == null || v === \"\" ||\n                     (Array.isArray(v) && v.length === 0) ||\n                     (typeof v === \"object\" && !Array.isArray(v) && Object.keys(v).length === 0)));\n    return arr;\n  }\n\n  if (value && typeof value === \"object\") {\n    const out = {};\n    for (const [k, v] of Object.entries(value)) {\n      const vv = clean(v);\n      const isEmptyObj = vv && typeof vv === \"object\" && !Array.isArray(vv) && Object.keys(vv).length === 0;\n      const isEmptyArr = Array.isArray(vv) && vv.length === 0;\n      if (!(vv == null || vv === \"\" || isEmptyObj || isEmptyArr)) {\n        out[k] = vv;\n      }\n    }\n    return out;\n  }\n\n// numbers 0 and boolean false are considered valid\n  return value;\n}\n\nreturn items.map(item => {\n  const cleaned = clean(item.json);   // the Webhook leaves the body in item.json\n  return { json: cleaned };\n});\n"
      },
